# Copy to .env and fill in from your Supabase project (Settings → API).
# Both are PUBLIC client values, protected by Row-Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Note: the USDA FoodData Central key is NOT a client value — it lives only as a
# Supabase secret (USDA_API_KEY) consumed by the usda-search Edge Function.
# Set it with: npx supabase secrets set USDA_API_KEY=<key from api.data.gov>
